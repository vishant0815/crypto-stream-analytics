    {
      "type": "table",
      "title": "Nightly batch runs (HDFS vs TimescaleDB reconciliation)",
      "description": "",
      "id": 31,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 13,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT dt::text AS \"day\", status, rows_hdfs AS \"HDFS rows\", rows_db AS \"DB rows\",\n       files_before AS \"files before\", files_after AS \"files after\",\n       round(extract(epoch FROM finished_at - started_at)) AS \"secs\"\nFROM batch_runs\nORDER BY started_at DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "mismatch": {
                        "color": "orange",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      },
                      "running": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
