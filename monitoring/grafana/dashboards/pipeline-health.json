          },
          "expr": "spark_streaming_watermark_delay_seconds",
          "legendFormat": "{{query}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
