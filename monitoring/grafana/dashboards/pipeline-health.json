        }
      }
    },
    {
      "type": "timeseries",
      "title": "Anomaly alerts",
      "description": "Unusual minutes flagged by the K-Means model (or the rules fallback)",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
