    {
      "type": "timeseries",
      "title": "Watermark delay",
      "description": "How far event time lags the wall clock: the 30 s allowed lateness plus processing time",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
