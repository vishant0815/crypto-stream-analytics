# Trading pairs to stream (comma-separated)
PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD

# Kafka address when running the ingestion service on your machine (outside Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

LOG_LEVEL=INFO
STATS_INTERVAL_S=10

# TimescaleDB (change the password for anything public)
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto

# Monitoring: Grafana's read-only database login, and the Grafana admin password
GRAFANA_DB_PASSWORD=grafana
GRAFANA_ADMIN_PASSWORD=admin

# Database address when running services on your machine (outside Docker)
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto

# db-writer batching
BATCH_SIZE=500
FLUSH_INTERVAL_S=1

# Spark streaming job
SPARK_MASTER=local[2]
WATERMARK=30 seconds
CANDLE_TRIGGER=1 second
INDICATOR_TRIGGER=10 seconds

# Data lake (HDFS archive and nightly batch)
ARCHIVE_TRIGGER=5 minutes
BATCH_TIME_UTC=00:30
BATCH_CATCH_UP_DAYS=7

# Anomaly detection
TRAIN_DAYS=30
MIN_TRAINING_ROWS=2000
MODEL_REFRESH_S=600

# ---------------------------------------------------------------- production
# Used by docker/docker-compose.prod.yml (see docs/DEPLOY.md). deploy/setup-server.sh
# fills these in and replaces every password above with a random one.

# The site's address, pointed at the server with a DNS A record. Caddy gets the
# HTTPS certificate for it and Let's Encrypt emails ACME_EMAIL about problems.
DOMAIN=
ACME_EMAIL=
# Grafana's public address is PUBLIC_URL/grafana/
PUBLIC_URL=http://localhost:3000

# Alert emails (optional). Leave ALERT_EMAIL_TO empty to only see alerts in the
# Alertmanager UI. For Gmail: SMTP_HOST=smtp.gmail.com:587, SMTP_USER is your
# Gmail address and SMTP_PASSWORD an app password (Google account > Security >
# 2-Step Verification > App passwords), not your normal password.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
