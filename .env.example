# Trading pairs to stream (comma-separated)
PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD

# Kafka address when running the ingestion service on your machine (outside Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

LOG_LEVEL=INFO
STATS_INTERVAL_S=10

# TimescaleDB (change the password for anything public)
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto

# Database address when running services on your machine (outside Docker)
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto

# db-writer batching
BATCH_SIZE=500
FLUSH_INTERVAL_S=1

# Spark streaming job
SPARK_MASTER=local[2]
WATERMARK=30 seconds
CANDLE_TRIGGER=1 second
INDICATOR_TRIGGER=10 seconds

# Data lake (HDFS archive and nightly batch)
ARCHIVE_TRIGGER=5 minutes
BATCH_TIME_UTC=00:30
BATCH_CATCH_UP_DAYS=7

# Anomaly detection
TRAIN_DAYS=30
MIN_TRAINING_ROWS=2000
MODEL_REFRESH_S=600
