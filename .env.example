# Trading pairs to stream (comma-separated)
PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD

# Kafka address when running the ingestion service on your machine (outside Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

LOG_LEVEL=INFO
STATS_INTERVAL_S=10

# TimescaleDB (change the password for anything public)
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto

# Database address when running services on your machine (outside Docker)
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto

# db-writer batching
BATCH_SIZE=500
FLUSH_INTERVAL_S=1
